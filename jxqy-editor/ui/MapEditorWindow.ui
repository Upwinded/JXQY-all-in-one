     <addaction name="separator"/>
     <addaction name="actionGotoTile"/>
     <addaction name="actionMapStatistics"/>
    </widget>
   </item>
  </layout>
  <action name="actionNewMap">
   <property name="text">
    <string>新建</string>
   </property>
   <property name="toolTip">
    <string>新建地图</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+N</string>
   </property>
  </action>

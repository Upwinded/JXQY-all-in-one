<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MapEditorWindow</class>
 <widget class="QWidget" name="MapEditorWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1200</width>
    <height>800</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>地图编辑器</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QToolBar" name="mapToolBar">
     <property name="windowTitle">
      <string>地图工具</string>
     </property>
     <addaction name="actionNewMap"/>
     <addaction name="actionOpenMap"/>
     <addaction name="actionSaveMap"/>
     <addaction name="actionSaveMapAs"/>
     <addaction name="separator"/>
     <addaction name="actionUndo"/>
